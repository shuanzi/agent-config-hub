{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Config Manager (Test Harness)",
  "identifier": "com.agentconfigmanager.testharness",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "l3-harness",
          "description": "L3 test-harness 专用权限：WDIO execute/mock 与 embedded WebDriver plugin。",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:default",
            "core:event:default",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Agent Config Manager (Test Harness)",
        "width": 1440,
        "height": 900
      }
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Config Manager (Dev)",
  "version": "0.1.0",
  "identifier": "com.agentconfigmanager.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Config Manager (Dev)",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}

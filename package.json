{
  "name": "agent-config-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent Config Manager — single-user local cross-agent configuration workbench (MVP)",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  },
  "scripts": {
    "verify:toolchain": "node scripts/orchestrator/verify-toolchain.mjs",
    "verify:static": "node scripts/orchestrator/verify-static.mjs",
    "test:rust": "node scripts/orchestrator/test-rust.mjs",
    "test:frontend": "vitest run",
    "test:ui": "wdio run tests/l2/wdio.conf.ts",
    "test:tauri": "node scripts/orchestrator/test-tauri.mjs",
    "perf": "node scripts/orchestrator/not-established.mjs perf-pf01-recalibration",
    "build:frontend": "tsc -b && vite build",
    "mock:ui": "vite --host 127.0.0.1 --port 1421 --strictPort --open '/?prototype=full-ui&variant=selected&journey=browse&scenario=ready'",
    "build:app": "node scripts/orchestrator/not-established.mjs build:app",
    "package:macos": "node scripts/orchestrator/not-established.mjs package:macos",
    "verify:ticket": "node scripts/orchestrator/verify-ticket.mjs",
    "verify:release": "node scripts/orchestrator/not-established.mjs verify:release"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@wdio/browser-runner": "^9.5.0",
    "@wdio/cli": "^9.5.0",
    "@wdio/local-runner": "^9.5.0",
    "@wdio/mocha-framework": "^9.5.0",
    "@wdio/spec-reporter": "^9.5.0",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "eslint": "^9.18.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "webdriverio": "^9.5.0"
  }
}
